{
  "name": "sentwise-service",
  "version": "0.1.0",
  "private": true,
  "description": "Sentwise managed-inference service \u2014 a stateless, zero-retention Cloudflare Worker that proxies drafting requests to Anthropic behind Clerk authentication.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "bash scripts/deploy-sandbox.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run lint && npm run typecheck && npm run test",
    "predeploy:sandbox": "npm run lint && npm run typecheck && npm run test",
    "gen-dev-vars": "bash scripts/gen-dev-vars.sh",
    "check-no-body-logging": "bash scripts/check-no-body-logging.sh",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "8.12.3"
  }
}
